NODE_ENV=development
PORT=5000
MONGODB_URI=your_mongodb_connection_string
MONGODB_DB_NAME=fieldflow
CORS_ORIGIN=https://localhost:5173

# Location tracking
LOCATION_HISTORY_RETENTION_DAYS=180
LOCATION_SAMPLE_INTERVAL_SECONDS=20
LOCATION_SAMPLE_MIN_DISTANCE_METERS=50
RECURRING_SCHEDULER_INTERVAL_SECONDS=60

# Web Push notifications
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Authentication
JWT_SECRET=your_secure_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=2h
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
AUTH_COOKIE_NAME=fieldflow_session
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=lax
