# Leave VITE_API_BASE_URL empty to use same-origin requests via the Vite dev proxy.
# The proxy forwards /api to the backend, so no hardcoded IP is needed.
# VITE_API_BASE_URL=https://localhost:5000
VITE_API_BASE_URL=
PORT=5000
VITE_ROUTING_PROVIDER=osrm
VITE_OSRM_URL=https://router.project-osrm.org
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- CORS ---
# Comma-separated list of trusted origins for cross-site requests. The
# server REFUSES TO START in production if this is set to "*". Use
# explicit origins in every deployment.
CORS_ORIGIN=https://localhost:5173

# --- Reverse proxy / trusted hops ---
# Set to a numeric hop count (e.g. "1") when running behind a single
# reverse proxy, or to "loopback" / "linklocal" / "uniquelocal" for
# Express's named presets. Leave empty to disable `trust proxy` entirely.
# Misconfiguring this can let attackers spoof their IP.
TRUST_PROXY=

# --- Authentication (REQUIRED) ---
# JWT signing secret. MUST be at least 32 characters of cryptographically
# random data. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server will refuse to start if JWT_SECRET is missing or too short.
JWT_SECRET=
JWT_EXPIRES_IN=2h
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
AUTH_COOKIE_NAME=fieldflow_session
AUTH_REFRESH_COOKIE_NAME=fieldflow_refresh
# Set to true in production (requires HTTPS).
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
# Per-IP authentication rate limits (per minute). These complement the
# per-account lockout and prevent credential stuffing from a single source.
AUTH_LOGIN_RATE_PER_MINUTE=10
AUTH_REGISTER_RATE_PER_MINUTE=5
AUTH_REFRESH_RATE_PER_MINUTE=30

# --- Location tracking ---
LOCATION_HISTORY_RETENTION_DAYS=180
LOCATION_SAMPLE_INTERVAL_SECONDS=20
LOCATION_SAMPLE_MIN_DISTANCE_METERS=50
RECURRING_SCHEDULER_INTERVAL_SECONDS=60
